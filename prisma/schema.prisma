// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id        String    @id @default(uuid())
  name      String
  address   String
  email     String?
  phone     String?
  gstin         String?
  cin           String?
  bankName      String?
  accountName   String?
  accountNumber String?
  ifsc          String?
  branch        String?
  createdAt     DateTime  @default(now())
  invoices      Invoice[]
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  date          DateTime
  dueDate       DateTime
  totalAmount           Float     @default(0)
  notes                 String?
  showPan               Boolean   @default(true)
  selectedPan           String?
  showClientBankDetails Boolean   @default(false)
  billerId              String    @default("rupali")
  createdAt             DateTime  @default(now())
  services              Service[]
}

model Service {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty         Int
  rate        Float
  total       Float
}

model Meta {
  key   String @id
  value Int
}
